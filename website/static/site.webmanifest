{
  "name": "SSH Config Manager",
  "short_name": "SSH Config",
  "description": "Open-source SSH configs, keys and tunnels for macOS and Linux. Edit ~/.ssh/config losslessly, manage keys and known_hosts, and run in-process SSH tunnels.",
